  "universal_guidelines_for_main_agent": [
    "NEVER use transparent backgrounds on headers without backdrop blur.",
    "Always include data-testid on buttons, inputs, tabs, and modals.",
    "Implement theme switchers dynamically updating CSS variables for SBI, HDFC, and ICICI.",
    "Ensure all API requests have robust error handling and loading skeletons."
  ]
}
