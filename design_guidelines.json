{
  "typography": {
    "font_family_heading": "Outfit, system-ui, sans-serif",
    "font_family_body": "Plus Jakarta Sans, system-ui, sans-serif",
    "font_family_mono": "JetBrains Mono, monospace",
    "hierarchy_rules": {
      "H1": "text-4xl sm:text-5xl font-extrabold tracking-tight",
      "H2": "text-2xl sm:text-3xl font-bold tracking-tight",
      "H3": "text-xl sm:text-2xl font-semibold",
      "H4": "text-lg font-semibold",
      "body": "text-base leading-relaxed",
      "small": "text-sm text-slate-500 dark:text-slate-400"
    }
  },
  "colors": {
    "themes": {
      "sbi_yono": {
        "name": "SBI YONO Navy & Sky",
        "primary": "#0F294A",
        "primary_foreground": "#FFFFFF",
        "accent": "#00A3E0",
        "accent_foreground": "#FFFFFF",
        "background": "#F4F7FA",
        "card": "#FFFFFF",
        "border": "#D2E0EE",
        "muted": "#5A738E"
      },
      "hdfc_bank": {
        "name": "HDFC Corporate Blue & Red",
        "primary": "#002A5C",
        "primary_foreground": "#FFFFFF",
        "accent": "#ED1C24",
        "accent_foreground": "#FFFFFF",
        "background": "#F7F8FA",
        "card": "#FFFFFF",
        "border": "#D8E2ED",
        "muted": "#4A5D78"
      },
      "icici_bank": {
        "name": "ICICI Wealth Orange & Maroon",
        "primary": "#8A1C14",
        "primary_foreground": "#FFFFFF",
        "accent": "#F37021",
        "accent_foreground": "#FFFFFF",
        "background": "#FAF7F5",
        "card": "#FFFFFF",
        "border": "#EAD7CE",
        "muted": "#75463E"
      }
    },
    "neutrals": {
      "slate_50": "#F8FAFC",
      "slate_900": "#0F172A"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/50 dark:border-slate-800/50",
    "shadows": "shadow-[0_8px_30px_rgb(0,0,0,0.06)]",
    "radii": "rounded-2xl"
  },
  "component_path": "/app/frontend/src/components",
  "layouts": {
    "dashboard_grid": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 p-6",
    "sidebar_layout": "flex h-screen bg-background overflow-hidden"
  },
  "motion": {
    "transition_standard": "transition-all duration-200 ease-in-out",
    "hover_lift": "hover:-translate-y-1 transition-transform duration-200"
  },
  "accessibility": {
    "contrast_minimum": "4.5:1 for normal text, 3:1 for large text",
    "focus_state": "focus:ring-2 focus:ring-primary focus:outline-none",
    "test_attributes": "All interactive elements must include data-testid attributes"
  },
  "image_urls": [
