# AJSPay on Hostinger (Apache / LiteSpeed)

Options -Indexes
ServerSignature Off
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Site switch: while /srv/ajspay/site-down is non-empty, everything answers
# 503 and tells the browser to drop its cached copy of the app and any saved
# sign-in. The owner flips it from /site/off/<key> and /site/on/<key>, which
# stay reachable while it is off, as does version.txt for the deploy check.
ErrorDocument 503 "<h1>Site not working</h1><p>This site is currently unavailable.</p>"
RewriteRule ^site/(on|off)/([0-9a-f]{64})$ site-switch.php?do=$1&k=$2 [L]
RewriteCond /srv/ajspay/site-down -s
RewriteCond %{REQUEST_URI} !^/(version\.txt|site-switch\.php|site/(on|off)/[0-9a-f]{64})$
RewriteRule ^ - [R=503,L,E=SITE_DOWN:1]

# Server-side only: PHP modules and assets are never fetched over HTTP
RewriteRule ^(modules|assets)/ - [F,L]

# Hand the Authorization header to PHP (CGI/FastCGI setups strip it otherwise)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /api/* -> api.php, which routes on the original request path
RewriteRule ^api/ api.php [L,QSA]

# React single-page app: serve real files, send every other path to index.html
# so /loans, /app/transfer and every other route survives a refresh.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Only api.php and the built frontend are reachable over HTTP.
# cron.php is CLI-only (it also refuses to run under a web SAPI).
<FilesMatch "^\.|\.(sql|md|log|env|ini|bak|example)$|^(db|config\.local|config\.rails|cron)\.php$">
    Require all denied
</FilesMatch>

# Cap request bodies at 8 MB (video KYC photos are the largest upload)
LimitRequestBody 8388608

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    # Needs the frontend built with INLINE_RUNTIME_CHUNK=false (see INSTALL_HOSTINGER.md)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://api.qrserver.com; connect-src 'self'; media-src 'self' blob:; frame-src https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header unset X-Powered-By
    Header always set Clear-Site-Data "\"cache\", \"storage\"" env=SITE_DOWN
    Header always set Cache-Control "no-store" env=SITE_DOWN
</IfModule>
